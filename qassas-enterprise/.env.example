# QASSAS Enterprise operational profile
QASSAS_ENVIRONMENT=local
QASSAS_RELEASE_ID=dev
QASSAS_SERVICE_VERSION=0.0.1
QASSAS_ALLOWED_ORIGINS=http://localhost:3000
QASSAS_REQUIRED_MIGRATION=202609240021_institutional_activation_term_sheet.sql

QASSAS_DB_HOST=127.0.0.1
QASSAS_DB_NAME=qassas
QASSAS_DB_USER=qassas
QASSAS_DB_PASSWORD=change-me
QASSAS_DB_PORT=5432
DATABASE_URL=

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8080
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/qassas-pilot
KEYCLOAK_API_CLIENT_ID=qassas-api

OPA_PORT=8181
OPA_URL=http://127.0.0.1:8181

TEMPORAL_PORT=7233
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=qassas-pilot
TEMPORAL_TASK_QUEUE=qassas-decision-review

# Local/CI runtime images are version-pinned. Pilot/Production uses deployment-specific profiles.
POSTGIS_IMAGE=postgis/postgis:18-3.6
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4
OPA_IMAGE=openpolicyagent/opa:1.20.2
TEMPORAL_IMAGE=temporalio/auto-setup:1.29.7

OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISH_INTERVAL_MS=1000
OUTBOX_PUBLISH_BATCH_SIZE=25
OUTBOX_CLAIM_TIMEOUT_SECONDS=300
